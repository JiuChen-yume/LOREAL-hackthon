.wechat-header{height:88rpx;padding:12rpx 28rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;background:rgba(250,246,243,.96);border-bottom:1rpx solid #f0ebe6}.brand{display:flex;align-items:center;gap:14rpx}.brand-mark{width:48rpx;height:48rpx;border-radius:50%;background:#e25c70;color:#fff;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:24rpx;font-weight:700}.brand-title{display:block;font-size:22rpx;font-weight:700;color:#292524;line-height:1.1}.brand-sub{display:block;font-size:16rpx;color:#a8a29e;margin-top:5rpx}.capsule{height:48rpx;min-width:108rpx;border:1rpx solid #d6d3d1;border-radius:999rpx;background:#fff;display:flex;align-items:center;justify-content:center;gap:14rpx;color:#57534e;font-size:22rpx}.capsule-line{width:1rpx;height:26rpx;background:#e7e5e4}
