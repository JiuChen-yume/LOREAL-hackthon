import React, { useState } from 'react';import {   ArrowLeft,   Sparkles,   Check,   Link2,   Wand2,   RefreshCw,   BookOpen,  Camera,  Layers,  ChevronRight,  Upload,  UserCheck} from 'lucide-react';import { BeautyProduct } from '../../types/beauty';import {   makeupGlamourImg,   makeupLookImg,   homePortraitImg,  skincareCalm } from '../../data/mockData';import { FaceSplitCanvas } from './FaceSplitCanvas';import { WebARMakeupMirror } from './WebARMakeupMirror';interface MakeupDetailStudioProps {  initialType: 'daily' | 'imitation' | 'cos' | 'template';  studioTitle: string;  onBack: () => void;  products: BeautyProduct[];  onRateLook?: (lookTitle: string, rating: 'red' | 'yellow' | 'black', reason: string) => void;}export const MakeupDetailStudio: React.FC<MakeupDetailStudioProps> = ({  initialType,  studioTitle,  onBack,  products,  onRateLook}) => {  // 1. Interactive Makeup Parameters (Matching 5b1e751c1e23c4d0c9f614c9787202b8.jpg)  const isCosDefault = initialType === 'cos';  const [lipColor, setLipColor] = useState(isCosDefault ? '#8B1E3F' : '#B2382D');  const [lipDepth, setLipDepth] = useState(isCosDefault ? 90 : 70);  const [lipEnabled, setLipEnabled] = useState(true);  const [cheekColor, setCheekColor] = useState(isCosDefault ? '#E85D75' : '#E2847A');  const [cheekAmount, setCheekAmount] = useState(isCosDefault ? 75 : 60);  const [cheekEnabled, setCheekEnabled] = useState(true);  const [eyeColor, setEyeColor] = useState(isCosDefault ? '#522039' : '#9C6858');  const [eyeIntensity, setEyeIntensity] = useState(isCosDefault ? 85 : 65);  const [eyeEnabled, setEyeEnabled] = useState(true);  const [baseFinish, setBaseFinish] = useState<'dewy' | 'matte'>(isCosDefault ? 'matte' : 'matte');  const [baseCoverage, setBaseCoverage] = useState(75);  // View mode: Tencent photo comparison or zoom.  const [viewMode, setViewMode] = useState<'split' | 'zoom'>('split');  const [userPhotoUrl, setUserPhotoUrl] = useState<string>(homePortraitImg);  // Tutorial Link Input & Parsing State  const [tutorialUrl, setTutorialUrl] = useState('');  const [isParsingTutorial, setIsParsingTutorial] = useState(false);  const [parsedTutorial, setParsedTutorial] = useState<any>(null);  // Active Template  const [activeTemplate, setActiveTemplate] = useState<string>(isCosDefault ? 'COS 漫展妆' : '韩系水光妆');  const [toastMessage, setToastMessage] = useState<string | null>(null);  const showToast = (msg: string) => {    setToastMessage(msg);    setTimeout(() => setToastMessage(null), 2500);  };  // Swatches for Lip from Vanity  const lipSwatches = [    { name: '豆沙粉', hex: '#C45868', isPick: false },    { name: '烂番茄', hex: '#B2382D', isPick: true },    { name: '乌木红棕', hex: '#853139', isPick: false },    { name: '蜜桃橘', hex: '#E0735E', isPick: false },  ];  // Swatches for Cheek from Vanity  const cheekSwatches = [    { name: '膨胀浅粉', hex: '#F5A4AC', isPick: false },    { name: '蜜桃肉桂', hex: '#E2847A', isPick: true },    { name: '杏子奶茶', hex: '#E8A48B', isPick: false },  ];  // 4 Instant Look Templates requested by user  const makeupTemplates = [    {      id: 'korean',      name: '韩系水光妆',      tag: '清透氧气 · 幼态膨胀',      lip: '#C45868',      lipDepth: 60,      cheek: '#F5A4AC',      cheekAmount: 50,      eye: '#A67B6F',      base: 'dewy' as const,      desc: '水光肌打底，面中膨胀色打亮，配水光感玻璃花瓣唇',      steps: [        { num: 1, title: '全脸水光底妆', desc: '美妆蛋轻拍滋润型粉底，打造无粉感通透水光肌' },        { num: 2, title: '卧蚕与眼眶提亮', desc: '浅粉金珠光扫于卧蚕与眼头，平拉自然眼线' },        { num: 3, title: '面中膨胀粉腮红', desc: '横向扫在眼下三角区与鼻尖，缩短中庭' },        { num: 4, title: '多汁透亮花瓣唇', desc: '内侧涂抹豆沙粉并用指腹向外轻拍模糊唇线' }      ]    },    {      id: 'asian',      name: '亚裔轻混血妆',      tag: '立体骨相 · 雾面高级',      lip: '#9E4B3E',      lipDepth: 75,      cheek: '#D08770',      cheekAmount: 65,      eye: '#6E4E42',      base: 'matte' as const,      desc: '丝绒雾面磨皮，深邃大地眼眶，裸感肉桂咖唇与骨相修容',      steps: [        { num: 1, title: '丝绒哑光修容底妆', desc: '高遮瑕粉底配合眼下散粉烘焙定妆，打造高级磨皮' },        { num: 2, title: '倒三角冷灰棕眼窝', desc: '斜上方晕染深棕眼尾，强化眉弓骨相立体感' },        { num: 3, title: '收缩暖杏修容腮红', desc: '由颧骨向内斜扫，收敛面宽，利落干练' },        { num: 4, title: '丰满饱满肉桂唇', desc: '勾勒出饱满唇峰与下唇边缘，哑光气场全开' }      ]    },    {      id: 'cos',      name: 'COS 漫展妆',      tag: '高显色 · 异色立体',      lip: '#8B1E3F',      lipDepth: 95,      cheek: '#E85D75',      cheekAmount: 80,      eye: '#522039',      base: 'matte' as const,      desc: '舞台强光抗吃妆，深红血色唇，异形猫眼深邃眼影，冷白无瑕',      steps: [        { num: 1, title: '冷白高遮瑕舞台底妆', desc: '无瑕粉底液全脸铺匀，高光提亮眉心与下巴' },        { num: 2, title: '异色夸张深邃眼线', desc: '深玫瑰棕全包眼线与下睫毛手绘，放大眼瞳' },        { num: 3, title: '微醺动漫血色腮红', desc: '眼尾与太阳穴大面积连贯泛红，二次元神态' },        { num: 4, title: '暗夜吸血鬼咬唇', desc: '暗深浆果红内涂，边缘点缀碎钻闪粉' }      ]    },    {      id: 'chinese',      name: '新中式千金妆',      tag: '温婉正红 · 东方美韵',      lip: '#B3262E',      lipDepth: 85,      cheek: '#E5928F',      cheekAmount: 60,      eye: '#82594E',      base: 'dewy' as const,      desc: '远山黛眉，温润珍珠肌，端庄经典朱砂红唇，典雅大气',      steps: [        { num: 1, title: '温润白玉珍珠底妆', desc: '微光泽粉底打造贵气自然气色，鼻梁骨干练' },        { num: 2, title: '远山含黛眼部神韵', desc: '温润浅金粉打底，自然眼尾微扬' },        { num: 3, title: '桃花微粉拂面', desc: '眼下至笑肌轻扫如淡墨桃花，温婉动人' },        { num: 4, title: '朱砂正色丝绒唇', desc: '正红色丝绒口红端正厚涂，尽显名门仪态' }      ]    }  ];  // Apply template  const applyTemplate = (t: typeof makeupTemplates[0]) => {    setActiveTemplate(t.name);    setLipColor(t.lip);    setLipDepth(t.lipDepth);    setLipEnabled(true);    setCheekColor(t.cheek);    setCheekAmount(t.cheekAmount);    setCheekEnabled(true);    setEyeColor(t.eye);    setEyeIntensity(70);    setEyeEnabled(true);    setBaseFinish(t.base);    showToast(`已加载「${t.name}」模版配色与分步方案`);  };  // Parse Tutorial Link via Backend API  const handleParseTutorial = async (inputStr?: string) => {    const textToParse = inputStr || tutorialUrl;    if (!textToParse) {      showToast('请先输入或粘贴妆教链接/文案');      return;    }    setIsParsingTutorial(true);    try {      const response = await fetch('/api/makeup/parse-tutorial', {        method: 'POST',        headers: { 'Content-Type': 'application/json' },        body: JSON.stringify({          url: textToParse,          description: textToParse,          vanityProducts: products        })      });      const data = await response.json() as any;      if (data.success && data.result) {        setParsedTutorial(data.result);        if (data.result.lipSetting) {          setLipColor(data.result.lipSetting.shadeHex || '#B2382D');          setLipDepth(data.result.lipSetting.depth || 75);          setLipEnabled(true);        }        if (data.result.cheekSetting) {          setCheekColor(data.result.cheekSetting.shadeHex || '#E2847A');          setCheekAmount(data.result.cheekSetting.amount || 60);          setCheekEnabled(true);        }        showToast(`已成功拆解「${data.result.title}」，色号已同步至面部`);      }    } catch (err) {      console.error(err);      showToast('妆教解析失败，请检查网络后重试');    } finally {      setIsParsingTutorial(false);    }  };  return (    <div className="p-3.5 sm:p-5 space-y-4 text-stone-900 select-none bg-[#FAF6F3]">      {/* Toast Alert */}      {toastMessage && (        <div className="fixed top-14 left-1/2 -translate-x-1/2 z-50 bg-stone-900/90 backdrop-blur-md text-white text-xs px-4 py-2 rounded-full shadow-lg flex items-center gap-1.5 animate-in fade-in">          <Check className="w-3.5 h-3.5 text-emerald-400" />          <span>{toastMessage}</span>        </div>      )}      {/* Top Navigation Bar with Back Button */}      <div className="flex items-center justify-between pt-1 pb-1 border-b border-[#EDE5DE]">        <button          onClick={onBack}          className="flex items-center gap-1.5 text-xs font-semibold text-stone-700 hover:text-[#962F43] transition-colors py-1 px-2 -ml-1 rounded-full hover:bg-stone-200/50"        >          <ArrowLeft className="w-4 h-4 stroke-[2.5]" />          <span>返回妆造工作室</span>        </button>        <span className="text-xs font-bold text-stone-900 font-serif">          {studioTitle}        </span>        <span className="text-[10px] px-2 py-0.5 rounded-full bg-[#E25C70]/15 text-[#CF3F57] font-semibold">          腾讯云 AI 试妆        </span>      </div>      {/* 核心板块：上传照片 · 使用腾讯云静态图片试妆 */}      <div className="bg-white rounded-3xl p-4 border border-[#F0EBE6] shadow-xs space-y-3">        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">          <div className="flex items-center gap-2.5">            <div className="w-9 h-9 rounded-full bg-rose-100/80 border border-rose-200 text-[#962F43] flex items-center justify-center shrink-0">              <Camera className="w-5 h-5" />            </div>            <div>              <div className="flex items-center gap-2">                <h3 className="text-sm font-bold text-stone-900 font-serif">                  上传我的照片                </h3>                <span className="text-[10px] px-2 py-0.5 rounded-full bg-rose-50 text-[#CF3F57] font-semibold border border-rose-200">                  腾讯云静态照片试妆                </span>              </div>              <p className="text-[11px] text-stone-500 mt-0.5">                上传正面自拍照片，腾讯云 SDK 将识别人脸并定位局部妆容区域              </p>            </div>          </div>          <div className="flex items-center gap-2 shrink-0">            <input               type="file"               id="makeup-user-photo-upload"              accept="image/*"               className="hidden"               onChange={(e) => {                const file = e.target.files?.[0];                if (file) {                  const reader = new FileReader();                  reader.onload = (event) => {                    if (event.target?.result) {                      setUserPhotoUrl(event.target.result as string);                      showToast('已成功上传面部照片，腾讯云试妆画布已更新！');                    }                  };                  reader.readAsDataURL(file);                }              }}            />            <label              htmlFor="makeup-user-photo-upload"              className="cursor-pointer px-4 py-2 rounded-full bg-gradient-to-r from-[#962F43] to-[#CF3F57] hover:from-[#832637] hover:to-[#bd334b] text-white text-xs font-bold shadow-xs flex items-center gap-1.5 transition-all active:scale-95"            >              <Upload className="w-4 h-4" />              <span>上传我的照片</span>            </label>          </div>        </div>        {/* 预设素颜脸模切换与模版快速选取 */}        <div className="pt-2 border-t border-stone-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">          <div className="flex items-center gap-1.5 overflow-x-auto scrollbar-none py-0.5">            <span className="text-[10px] text-stone-400 whitespace-nowrap">或选用示例自拍脸型：</span>            {[              { id: 'natural', name: '自然素颜', url: homePortraitImg },              { id: 'fair', name: '冷调净透', url: makeupGlamourImg },              { id: 'warm', name: '暖调柔和', url: makeupLookImg },            ].map((face) => (              <button                key={face.id}                onClick={() => {                  setUserPhotoUrl(face.url);                  showToast(`已切换为「${face.name}」自拍底卡`);                }}                className={`flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-medium whitespace-nowrap border transition-all ${                  userPhotoUrl === face.url                     ? 'border-[#962F43] bg-rose-50 text-[#962F43] font-bold shadow-2xs'                     : 'border-stone-200 bg-stone-50 hover:bg-white text-stone-600'                }`}              >                <div className="w-3.5 h-3.5 rounded-full overflow-hidden border border-stone-200">                  <img src={face.url} alt={face.name} className="w-full h-full object-cover" />                </div>                <span>{face.name}</span>              </button>            ))}          </div>          <div className="flex items-center gap-1.5 overflow-x-auto scrollbar-none py-0.5">            <span className="text-[10px] text-stone-400 whitespace-nowrap">妆容模版：</span>            {makeupTemplates.map((tpl) => (              <button                key={tpl.id}                onClick={() => applyTemplate(tpl)}                className={`px-2 py-0.5 rounded-full text-[10px] border transition-colors whitespace-nowrap ${                  activeTemplate === tpl.name                    ? 'border-[#CF3F57] bg-rose-50 text-[#CF3F57] font-bold'                    : 'border-stone-200 bg-white text-stone-600 hover:text-stone-900'                }`}              >                {tpl.name}              </button>            ))}          </div>        </div>      </div>      <WebARMakeupMirror />      {/* 2. CORE TWO-COLUMN INTERACTIVE STUDIO (Tencent photo comparison + vanity controls) */}      <div className="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">        {/* Left Column: Tencent photo comparison viewport */}        <div className="lg:col-span-5 w-full">          <FaceSplitCanvas            lipColor={lipColor}            lipDepth={lipDepth}            lipEnabled={lipEnabled}            cheekColor={cheekColor}            cheekAmount={cheekAmount}            cheekEnabled={cheekEnabled}            eyeColor={eyeColor}            eyeIntensity={eyeIntensity}            eyeEnabled={eyeEnabled}            baseFinish={baseFinish}            baseCoverage={baseCoverage}            viewMode={viewMode}            onViewModeChange={setViewMode}            userPhotoUrl={userPhotoUrl}            onUploadPhoto={setUserPhotoUrl}          />        </div>        {/* Right Column (7 Cols): Step-by-Step Vanity Customization Cards (Matching 5b1e751c1e23c4d0c9f614c9787202b8.jpg) */}        <div className="lg:col-span-7 space-y-3">          {/* Card 1: LIP 1/6 */}          <div className="bg-white rounded-3xl p-3.5 border border-[#F0EBE6] shadow-xs space-y-2.5">            <div className="flex items-center justify-between">              <div className="flex items-center gap-2">                <span className="text-[11px] font-mono font-bold tracking-wider text-stone-400">LIP 1/6</span>                <span className="text-xs font-bold text-stone-800">唇妆 · 调取化妆台口红</span>              </div>              {/* ON/OFF Switch */}              <button                onClick={() => setLipEnabled(!lipEnabled)}                className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold transition-colors ${                  lipEnabled ? 'bg-[#962F43] text-white shadow-2xs' : 'bg-stone-200 text-stone-500'                }`}              >                {lipEnabled ? 'ON' : 'OFF'}              </button>            </div>            <div className="flex items-center gap-3">              {/* Lipstick bullet illustration / vanity image */}              <div className="w-12 h-16 rounded-2xl overflow-hidden bg-rose-50/50 border border-rose-100 flex items-center justify-center shrink-0">                <img src={makeupLookImg} alt="口红单品" className="w-full h-full object-cover" />              </div>              <div className="flex-1 space-y-2">                {/* Swatches */}                <div className="flex items-center gap-2">                  {lipSwatches.map((swatch) => {                    const isSelected = lipColor === swatch.hex;                    return (                      <div key={swatch.hex} className="flex flex-col items-center gap-0.5">                        {swatch.isPick && (                          <span className="text-[8px] bg-amber-100 text-amber-800 px-1 rounded-full font-bold">                            AI PICK                          </span>                        )}                        <button                          onClick={() => {                            setLipColor(swatch.hex);                            setLipEnabled(true);                            showToast(`已更换唇色为「${swatch.name}」`);                          }}                          className={`w-7 h-7 rounded-full shadow-2xs border-2 transition-transform ${                            isSelected ? 'scale-115 border-stone-800 ring-2 ring-rose-300' : 'border-white'                          }`}                          style={{ backgroundColor: swatch.hex }}                          title={swatch.name}                        />                      </div>                    );                  })}                </div>                <div className="text-xs font-serif italic text-stone-700">                  Your lipstick · 柔雾丝绒口红                </div>                {/* Depth Slider */}                <div className="space-y-1">                  <div className="flex items-center justify-between text-[10px] text-stone-500">                    <span className="font-mono uppercase font-bold text-[9px]">DEPTH</span>                    <span>{lipDepth > 70 ? '浓郁厚涂 Two coats' : lipDepth > 40 ? '适中叠涂 One coat' : '自然薄涂 Sheer'}</span>                  </div>                  <input                    type="range"                    min="10"                    max="100"                    value={lipDepth}                    onChange={(e) => setLipDepth(Number(e.target.value))}                    className="w-full accent-[#962F43] h-1.5 bg-stone-100 rounded-lg cursor-pointer"                  />                </div>              </div>            </div>          </div>          {/* Card 2: CHEEK 1/7 */}          <div className="bg-white rounded-3xl p-3.5 border border-[#F0EBE6] shadow-xs space-y-2.5">            <div className="flex items-center justify-between">              <div className="flex items-center gap-2">                <span className="text-[11px] font-mono font-bold tracking-wider text-stone-400">CHEEK 1/7</span>                <span className="text-xs font-bold text-stone-800">腮红 · 调取化妆台腮红/口红</span>              </div>              {/* ON/OFF Switch */}              <button                onClick={() => setCheekEnabled(!cheekEnabled)}                className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold transition-colors ${                  cheekEnabled ? 'bg-[#962F43] text-white shadow-2xs' : 'bg-stone-200 text-stone-500'                }`}              >                {cheekEnabled ? 'ON' : 'OFF'}              </button>            </div>            <div className="flex items-center gap-3">              {/* Blush compact illustration */}              <div className="w-12 h-16 rounded-2xl overflow-hidden bg-rose-50/50 border border-rose-100 flex items-center justify-center shrink-0">                <img src={skincareCalm} alt="腮红单品" className="w-full h-full object-cover" />              </div>              <div className="flex-1 space-y-2">                {/* Swatches */}                <div className="flex items-center gap-2">                  {cheekSwatches.map((swatch) => {                    const isSelected = cheekColor === swatch.hex;                    return (                      <div key={swatch.hex} className="flex flex-col items-center gap-0.5">                        {swatch.isPick && (                          <span className="text-[8px] bg-amber-100 text-amber-800 px-1 rounded-full font-bold">                            AI PICK                          </span>                        )}                        <button                          onClick={() => {                            setCheekColor(swatch.hex);                            setCheekEnabled(true);                            showToast(`已更换腮红色号为「${swatch.name}」`);                          }}                          className={`w-7 h-7 rounded-full shadow-2xs border-2 transition-transform ${                            isSelected ? 'scale-115 border-stone-800 ring-2 ring-rose-300' : 'border-white'                          }`}                          style={{ backgroundColor: swatch.hex }}                          title={swatch.name}                        />                      </div>                    );                  })}                </div>                <div className="text-xs font-serif italic text-stone-700">                  Your blush · 膨胀收缩面中氛围                </div>                {/* Amount Slider */}                <div className="space-y-1">                  <div className="flex items-center justify-between text-[10px] text-stone-500">                    <span className="font-mono uppercase font-bold text-[9px]">AMOUNT</span>                    <span>{cheekAmount > 70 ? '浓郁微醺 Vibrant' : cheekAmount > 40 ? '自然适中 Medium' : '清透裸感 Light'}</span>                  </div>                  <input                    type="range"                    min="10"                    max="100"                    value={cheekAmount}                    onChange={(e) => setCheekAmount(Number(e.target.value))}                    className="w-full accent-[#962F43] h-1.5 bg-stone-100 rounded-lg cursor-pointer"                  />                </div>              </div>            </div>          </div>          {/* Card 3: BASE & EYE Finish controls */}          <div className="grid grid-cols-2 gap-2">            {/* Base control */}            <div className="bg-white rounded-2xl p-3 border border-[#F0EBE6] shadow-xs space-y-2">              <div className="flex items-center justify-between text-xs font-bold text-stone-800">                <span>底妆质感</span>                <span className="text-[10px] text-stone-400 font-normal">轻透持妆粉底</span>              </div>              <div className="flex items-center gap-1.5 bg-stone-100 p-1 rounded-xl text-[11px]">                <button                  onClick={() => setBaseFinish('matte')}                  className={`flex-1 py-1 rounded-lg font-medium transition-all ${                    baseFinish === 'matte' ? 'bg-white text-stone-900 shadow-2xs' : 'text-stone-500'                  }`}                >                  柔雾哑光                </button>                <button                  onClick={() => setBaseFinish('dewy')}                  className={`flex-1 py-1 rounded-lg font-medium transition-all ${                    baseFinish === 'dewy' ? 'bg-white text-stone-900 shadow-2xs' : 'text-stone-500'                  }`}                >                  清透水光                </button>              </div>            </div>            {/* Eye control */}            <div className="bg-white rounded-2xl p-3 border border-[#F0EBE6] shadow-xs space-y-2">              <div className="flex items-center justify-between text-xs font-bold text-stone-800">                <span>九色眼影盘</span>                <button                  onClick={() => setEyeEnabled(!eyeEnabled)}                  className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${                    eyeEnabled ? 'bg-[#962F43] text-white' : 'bg-stone-200 text-stone-500'                  }`}                >                  {eyeEnabled ? 'ON' : 'OFF'}                </button>              </div>              <div className="flex items-center gap-1.5 pt-1">                {['#9C6858', '#C27C72', '#D8A096'].map((c) => (                  <button                    key={c}                    onClick={() => {                      setEyeColor(c);                      setEyeEnabled(true);                    }}                    className={`flex-1 h-5 rounded-md border ${                      eyeColor === c ? 'ring-2 ring-stone-900' : 'border-stone-200'                    }`}                    style={{ backgroundColor: c }}                  />                ))}              </div>            </div>          </div>          {/* Action buttons matching 5b1e751c1e23c4d0c9f614c9787202b8.jpg footer */}          <div className="bg-white/80 rounded-2xl p-3 border border-[#EDE5DE] space-y-2.5">            <div className="text-[11px] text-stone-500 space-y-0.5">              <p className="font-serif">Yours · velvet · colour strength 4/5</p>              <p className="text-[10px] text-stone-400">Read from the photo of your own lipstick in vanity.</p>            </div>            <div className="flex items-center gap-2">              <button                onClick={() => {                  setLipEnabled(false);                  setCheekEnabled(false);                  setEyeEnabled(false);                  showToast('已还原素颜状态 (BARE)');                }}                className="px-3.5 py-2 rounded-full border border-stone-200 bg-white hover:bg-stone-50 text-xs font-bold text-stone-700 transition-colors"              >                BARE              </button>              <button                onClick={() => {                  const randomLip = lipSwatches[Math.floor(Math.random() * lipSwatches.length)];                  const randomCheek = cheekSwatches[Math.floor(Math.random() * cheekSwatches.length)];                  setLipColor(randomLip.hex);                  setCheekColor(randomCheek.hex);                  showToast(`AI已生成全新配色组合：${randomLip.name} + ${randomCheek.name}`);                }}                className="px-3.5 py-2 rounded-full border border-stone-200 bg-white hover:bg-stone-50 text-xs font-bold text-stone-700 transition-colors flex items-center gap-1"              >                <RefreshCw className="w-3.5 h-3.5" />                <span>Grow another five</span>              </button>              <button                onClick={() => {                  if (onRateLook) {                    onRateLook(studioTitle, 'red', '妆面色号巨适配，自然提气色');                  }                  showToast('已保存当前妆造至我的肌肤记忆红榜！✓');                }}                className="flex-1 py-2 rounded-full bg-[#962F43] hover:bg-[#832637] text-white text-xs font-bold shadow-xs transition-all flex items-center justify-center gap-1"              >                <span>Press this one ✓</span>              </button>            </div>            <div className="text-center text-[9px] text-stone-400 font-mono">              painted on your device · 131 ms · skin texture kept            </div>          </div>        </div>      </div>      {/* 3. 妆教链接解析 (小红书 / 抖音 / B站等) */}      <div className="bg-white rounded-3xl p-4 border border-[#F0EBE6] shadow-xs space-y-3">        <div className="flex items-center justify-between">          <div className="flex items-center gap-2">            <div className="w-7 h-7 rounded-full bg-rose-100 text-[#CF3F57] flex items-center justify-center">              <Link2 className="w-4 h-4" />            </div>            <div>              <h3 className="text-xs font-bold text-stone-900">                妆教链接 AI 智能拆解与生成              </h3>              <p className="text-[10px] text-stone-400">                输入抖音、小红书妆教链接或文本，生成最终妆效并输出分步演示              </p>            </div>          </div>          <span className="text-[10px] px-2 py-0.5 rounded-full bg-rose-50 text-[#CF3F57] font-semibold border border-rose-200">            支持小红书/抖音          </span>        </div>        {/* Input Box & Parse Action */}        <div className="flex items-center gap-2">          <div className="flex-1 relative">            <input              type="text"              value={tutorialUrl}              onChange={(e) => setTutorialUrl(e.target.value)}              placeholder="粘贴小红书/抖音妆教链接，如：http://xhslink.com/xx 鞠婧祎倒三角妆教..."              className="w-full px-3.5 py-2.5 text-xs bg-stone-50 rounded-2xl border border-stone-200 placeholder:text-stone-400 focus:outline-none focus:ring-1 focus:ring-[#962F43]"            />          </div>          <button            disabled={isParsingTutorial}            onClick={() => handleParseTutorial()}            className="px-4 py-2.5 rounded-2xl bg-gradient-to-r from-[#E25C70] to-[#CF3F57] text-white text-xs font-semibold shadow-xs flex items-center gap-1.5 shrink-0 hover:from-[#d64e62] hover:to-[#bd334b] transition-all disabled:opacity-60"          >            <Wand2 className="w-3.5 h-3.5" />            <span>{isParsingTutorial ? '拆解中...' : 'AI 拆解生成'}</span>          </button>        </div>        {/* Fast Example Links */}        <div className="flex items-center gap-1.5 overflow-x-auto scrollbar-none py-0.5">          <span className="text-[10px] text-stone-400 whitespace-nowrap">快捷示例：</span>          {[            { label: '小红书: 鞠婧祎倒三角妆', query: '小红书 鞠婧祎同款倒三角白开水妆' },            { label: '抖音: 白桃微醺纯欲妆', query: '抖音 @小猪姐姐 纯欲白桃微醺仿妆' },            { label: 'B站: 漫展高显色动漫COS妆', query: '漫展异色瞳高显色动漫立体角色妆' },            { label: '小红书: 亚裔轻欧美千金妆', query: '小红书 亚裔轻欧美千金骨相妆' }          ].map((ex) => (            <button              key={ex.label}              onClick={() => {                setTutorialUrl(ex.query);                handleParseTutorial(ex.query);              }}              className="px-2.5 py-1 rounded-full text-[10px] bg-white border border-stone-200 text-stone-600 hover:text-[#CF3F57] hover:border-rose-300 transition-colors whitespace-nowrap"            >              {ex.label}            </button>          ))}        </div>        {/* PARSED TUTORIAL BREAKDOWN & STEP DEMO DIAGRAMS */}        {parsedTutorial && (          <div className="pt-3 border-t border-stone-100 space-y-3 animate-in fade-in">            {/* Header of Tutorial */}            <div className="flex items-start justify-between bg-gradient-to-r from-rose-50/70 to-amber-50/70 p-3 rounded-2xl border border-rose-100">              <div className="space-y-0.5">                <div className="flex items-center gap-1.5">                  <span className="text-[9px] bg-[#CF3F57] text-white px-1.5 py-0.5 rounded-full font-bold">                    {parsedTutorial.platform || '小红书'}                  </span>                  <span className="text-xs font-bold text-stone-900">{parsedTutorial.title}</span>                </div>                <p className="text-[10px] text-stone-600 mt-0.5">{parsedTutorial.summary}</p>              </div>              <button                onClick={() => {                  if (parsedTutorial.lipSetting) setLipColor(parsedTutorial.lipSetting.shadeHex);                  if (parsedTutorial.cheekSetting) setCheekColor(parsedTutorial.cheekSetting.shadeHex);                  showToast('已同步此妆教全套配色至试妆镜！');                }}                className="px-3 py-1 rounded-full bg-[#962F43] text-white text-[10px] font-bold shrink-0 shadow-2xs"              >                应用至当前妆面              </button>            </div>            {/* 4 Step Diagram Cards (步骤演示图) */}            <div className="space-y-1.5">              <div className="flex items-center justify-between text-xs font-bold text-stone-900 px-1">                <div className="flex items-center gap-1">                  <BookOpen className="w-3.5 h-3.5 text-[#CF3F57]" />                  <span>妆教步骤演示图解（结合化妆台已有产品）</span>                </div>                <span className="text-[10px] text-emerald-700 font-semibold">100% 优先现有彩妆</span>              </div>              <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">                {parsedTutorial.stepDiagrams?.map((step: any) => (                  <div                    key={step.step}                    className="p-3 bg-stone-50/80 rounded-2xl border border-stone-200/70 flex items-start gap-2.5"                  >                    <div className="w-6 h-6 rounded-full bg-[#962F43] text-white text-[11px] font-bold flex items-center justify-center shrink-0">                      {step.step}                    </div>                    <div className="flex-1 min-w-0 space-y-1">                      <div className="flex items-center justify-between">                        <h4 className="text-xs font-bold text-stone-900">{step.title}</h4>                        <span className="text-[9px] px-1.5 py-0.5 rounded-full bg-rose-100 text-[#CF3F57] font-semibold">                          {step.area}                        </span>                      </div>                      <p className="text-[10px] text-stone-600 leading-relaxed">                        {step.tip}                      </p>                      <div className="text-[9px] text-[#962F43] font-medium flex items-center gap-1 pt-0.5">                        <span>调取化妆台：</span>                        <span className="underline">{step.vanityProduct}</span>                      </div>                    </div>                  </div>                ))}              </div>            </div>          </div>        )}      </div>    </div>  );};