page{background:#fff9f5;color:#341d2b;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}.page{padding:22rpx 28rpx 170rpx;box-sizing:border-box}.title{font-size:52rpx;font-weight:700;letter-spacing:2rpx}.sub{color:#8f8281;margin-top:10rpx}.section-title{font-size:36rpx;font-weight:700;margin:34rpx 0 20rpx}.card{background:rgba(255,255,255,.88);border-radius:28rpx;box-shadow:0 10rpx 32rpx rgba(111,66,61,.08);padding:28rpx;box-sizing:border-box}.pill{display:inline-flex;align-items:center;padding:12rpx 22rpx;border-radius:999rpx;background:#fff0ee;color:#d94e5e;margin-right:12rpx;margin-bottom:12rpx}.primary{background:#ed6470;color:#fff;border:0;border-radius:999rpx;padding:22rpx 34rpx;font-size:30rpx;font-weight:600}.ghost{background:#fff;border:2rpx solid #ed6470;color:#df5664;border-radius:999rpx;padding:18rpx 28rpx;font-size:26rpx}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.muted{color:#978887}.danger{color:#d44758}.success{color:#4f8b72}.hairline{height:1rpx;background:#f1e3df;margin:22rpx 0}

.strong{font-weight:700}.large{font-size:1.4em}.small{font-size:22rpx;color:#918383}.line-break{display:block}
.page-header{min-height:190rpx;margin:-32rpx -28rpx 24rpx;padding:36rpx 28rpx 24rpx;background-repeat:no-repeat;background-position:right top;background-size:cover;border-radius:0 0 30rpx 30rpx;box-sizing:border-box}.page-header .title{max-width:70%}.page-header .sub{max-width:72%}.vanity-header{background-size:cover}.care-header{background-size:cover}.makeup-header{background-size:cover}.skin-header{background-size:38% auto;background-position:right top;background-color:#f9fbf5}.store-header{background-size:cover}.cycle-header{background-size:cover}
.vanity-header{height:150rpx;min-height:150rpx;background-size:100% auto;background-position:top}.store-header{height:150rpx;min-height:150rpx;background-size:100% auto;background-position:top}.cycle-header{height:180rpx;min-height:180rpx;background-size:100% auto;background-position:top}
.zip-page{background:#faf6f3;min-height:100vh;padding:0 28rpx 150rpx}.zip-top{display:flex;justify-content:space-between;align-items:center;padding:26rpx 0 18rpx}.zip-title{font:700 44rpx/1.2 serif;color:#292524}.spark{color:#e25c70}.zip-sub{font-size:20rpx;color:#78716c;margin-top:6rpx}.top-actions{display:flex;gap:24rpx;font-size:42rpx;color:#292524}.greeting-card{height:300rpx;position:relative;overflow:hidden;border:1rpx solid #f5dcd5;border-radius:32rpx;background:linear-gradient(110deg,#fff5f1,#fdece7);box-shadow:0 8rpx 24rpx rgba(110,73,62,.08)}.greeting-copy{position:relative;z-index:2;width:56%;padding:30rpx 24rpx;font-size:22rpx;line-height:1.55;color:#57534e}.greeting-title{font:700 48rpx/1.1 serif;color:#292524;margin-bottom:14rpx}.greeting-card image{position:absolute;right:0;top:0;width:52%;height:100%;object-fit:cover;object-position:center}.weather-row{display:flex;gap:12rpx;margin-top:24rpx;font-size:18rpx;white-space:nowrap}.weather-row text{background:#fffdfb;padding:10rpx;border-radius:999rpx}.weather-row b{color:#d9534f}.soft-card{background:#fff;border:1rpx solid #f0ebe6;border-radius:32rpx;box-shadow:0 8rpx 26rpx rgba(110,73,62,.06)}.skin-panel{margin-top:20rpx;padding:24rpx}.skin-head{display:flex;gap:16rpx}.avatar{width:64rpx;height:64rpx;border-radius:50%;background:#fff0ee;display:flex;align-items:center;justify-content:center;font-size:34rpx;flex:none}.skin-head view{display:flex;flex-direction:column;gap:5rpx}.skin-title{font:bold 30rpx serif;color:#292524}.muted{display:block;color:#78716c;font-size:20rpx;line-height:1.5}.recommend-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;border-top:1rpx solid #f5f0eb;margin-top:22rpx;padding-top:18rpx}.recommend-label{display:block;color:#4a7057;font-size:20rpx}.recommend-title{display:block;color:#962f43;font:bold 27rpx serif;margin:4rpx 0}.zip-primary{border:0;border-radius:999rpx;background:#e25c70;color:#fff;font-size:22rpx;padding:20rpx 24rpx;white-space:nowrap}.section-line{display:flex;justify-content:space-between;align-items:center;font:bold 30rpx serif;margin:30rpx 4rpx 16rpx}.link{font:22rpx sans-serif;color:#78716c}.task-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.task-card{background:#fff;border:1rpx solid #f0ebe6;border-radius:24rpx;padding:12rpx 10rpx;box-shadow:0 6rpx 18rpx rgba(110,73,62,.05);min-width:0}.task-top{display:flex;justify-content:space-between;align-items:center}.task-top image{width:60rpx;height:60rpx;border-radius:16rpx}.check{font-size:34rpx;color:#cfc8c4}.check.done{color:#4a9b78}.task-title{display:block;font-size:19rpx;font-weight:700;margin-top:10rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:22rpx}.quick-card{background:#fff;border:1rpx solid #f0ebe6;border-radius:24rpx;padding:18rpx 8rpx;text-align:center;display:flex;flex-direction:column;gap:7rpx;align-items:center;font-size:20rpx}.quick-icon{width:58rpx;height:58rpx;border-radius:50%;background:#fff0ee;color:#e25c70;font-size:34rpx;display:flex;align-items:center;justify-content:center}.quick-card small{font-size:16rpx;color:#a8a29e}.cycle-strip{display:flex;align-items:center;gap:16rpx;margin-top:22rpx;padding:14rpx;border-radius:28rpx;background:#fff0ed;border:1rpx solid #f5dcd5}.cycle-strip image{width:100rpx;height:78rpx;border-radius:20rpx}.cycle-strip view{flex:1}.cycle-strip text{display:block;color:#4a7057;font:bold 28rpx serif}.cycle-strip small{display:block;font-size:18rpx;color:#78716c;margin-top:5rpx}.cycle-strip button{border:0;border-radius:999rpx;background:#e25c70;color:#fff;font-size:18rpx;padding:12rpx 18rpx}.toast{position:fixed;top:110rpx;left:50%;transform:translateX(-50%);z-index:50;color:#fff;background:rgba(41,37,36,.92);padding:14rpx 26rpx;border-radius:999rpx;font-size:22rpx}

.reference-page{padding:0!important;background:#faf6f3;min-height:100vh}.reference-page .reference-screen{padding-bottom:0}