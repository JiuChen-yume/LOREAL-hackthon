<view class="page zip-page vanity-page"><view class="zip-top"><view><view class="zip-title">我的化妆台</view><view class="zip-sub">记录我的每一件美丽，让好产品被好好使用</view></view><text class="top-plus" bindtap="add">+</text></view><view class="vanity-stats soft-card"><view><text class="small">全部单品</text><text class="strong">{{products.length}}</text><text class="small">在用管理中</text></view><view><text class="small">临期提醒</text><text class="strong amber">{{products.length?1:0}}</text><text class="small">近30天到期</text></view><view><text class="small">闲置拯救</text><text class="strong rose">{{products.length?1:0}}</text><text class="small">配方唤醒计划</text></view><button class="zip-primary" bindtap="add">+ 添加产品</button></view><view class="search-box"><text>⌕</text><input value="{{query}}" bindinput="search" placeholder="搜索化妆台单品名称、品牌或成分..."/></view><scroll-view scroll-x class="zip-tabs"><text wx:for="{{filters}}" wx:key="*this" class="zip-tab {{active===item?'active':''}}" data-v="{{item}}" bindtap="select">{{item}}</text></scroll-view><view class="product-grid"><view wx:for="{{visible}}" wx:key="id" class="product-card soft-card" data-item="{{item}}" bindtap="open"><view class="product-photo"><image src="{{item.image_url}}" mode="aspectFill"/><text class="status-tag {{item.status}}">{{item.status==='expiring_soon'?'临期':item.status==='idle'?'闲置':item.list_status==='red'?'红榜':'正常'}}</text></view><text class="product-brand">{{item.brand}}</text><text class="product-name">{{item.product_name}}</text><text class="muted">{{item.subcategory}} · {{item.size}}</text><view class="product-foot"><text>已使用 {{item.usage_count}} 次</text><button bindtap="addPlan" catchtap="addPlan">+ 排程</button></view></view></view><view wx:if="{{detail}}" class="modal-mask" catchtap="close"><view class="modal-card" catchtap="noop"><view class="modal-title">{{detail.product_name}} <text bindtap="close">x</text></view><image class="modal-image" src="{{detail.image_url}}" mode="aspectFill"/><text class="modal-brand">{{detail.brand}} · {{detail.subcategory}}</text><text class="muted">到期：{{detail.expiry_date}} · 已使用 {{detail.usage_count}} 次</text><view class="ingredient-list"><text wx:for="{{detail.ingredients}}" wx:key="*this">{{item}}</text></view><button class="zip-primary" bindtap="compat">检测成分搭配</button></view></view><bottom-nav active-key="vanity"/></view>