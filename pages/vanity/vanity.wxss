.summary{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.summary view{display:flex;flex-direction:column;gap:8rpx}.summary .strong{font-size:44rpx}.summary text{color:#8c7e7b}.summary .primary{padding:20rpx 24rpx;font-size:26rpx}.search{margin-top:20rpx;color:#a49794}.filters{white-space:nowrap;margin:22rpx 0}.filters .pill{display:inline-flex}.filters .active{background:#ed6470;color:#fff}.product{position:relative;padding:18rpx;overflow:hidden}.product image{width:100%;height:190rpx;border-radius:18rpx;display:block}.tag{position:absolute;top:30rpx;left:30rpx;background:#fff8;padding:6rpx 14rpx;border-radius:999rpx;font-size:22rpx}.product-name{font-size:29rpx;font-weight:600;margin:18rpx 0 8rpx}.product-actions{display:flex;gap:8rpx;margin-top:16rpx}.product-actions button{font-size:21rpx;padding:12rpx 10rpx;flex:1}.product-actions .primary{padding:12rpx 8rpx}
.vanity-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;padding:22rpx;margin-bottom:20rpx}.vanity-stats view{display:flex;flex-direction:column;gap:6rpx}.vanity-stats small{font-size:18rpx;color:#78716c}.vanity-stats strong{font:700 46rpx serif;color:#292524}.vanity-stats .amber{color:#d97706}.vanity-stats .rose{color:#cf3f57}.vanity-stats button{grid-column:1/-1}.top-plus{font-size:46rpx;color:#962f43}.search-box{display:flex;align-items:center;gap:10rpx;padding:18rpx 22rpx;background:#fff;border:1rpx solid #ede5de;border-radius:24rpx;color:#78716c}.search-box input{flex:1;font-size:21rpx}.zip-tabs{white-space:nowrap;margin:20rpx 0}.zip-tab{display:inline-block;padding:14rpx 24rpx;margin-right:10rpx;border:1rpx solid #ede5de;border-radius:999rpx;background:#fff;font-size:20rpx;color:#57534e}.zip-tab.active{background:#962f43;color:#fff;border-color:#962f43}.product-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx}.product-card{padding:14rpx}.product-photo{height:210rpx;border-radius:22rpx;overflow:hidden;position:relative;background:#faf6f3}.product-photo image{width:100%;height:100%}.status-tag{position:absolute;top:10rpx;left:10rpx;border-radius:999rpx;padding:7rpx 12rpx;background:#fff;color:#57534e;font-size:17rpx}.status-tag.expiring_soon{color:#b45309;background:#fff7ed}.status-tag.idle{color:#57534e;background:#f5f5f4}.status-tag.in_use{color:#166534;background:#f0fdf4}.product-brand,.product-name{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.product-brand{font-size:17rpx;color:#a8a29e;margin-top:12rpx}.product-name{font-size:21rpx;font-weight:700;margin-top:4rpx}.product-foot{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid #f0ebe6;margin-top:12rpx;padding-top:10rpx;color:#a8a29e;font-size:16rpx}.product-foot button{border:0;background:none;color:#962f43;font-size:18rpx}.modal-mask{position:fixed;inset:0;background:rgba(41,37,36,.55);z-index:60;display:flex;align-items:flex-end;padding:24rpx}.modal-card{width:100%;box-sizing:border-box;background:#fff;border-radius:32rpx;padding:28rpx;display:flex;flex-direction:column;gap:16rpx}.modal-title{font:bold 30rpx serif;display:flex;justify-content:space-between}.modal-image{width:180rpx;height:180rpx;border-radius:24rpx;align-self:center}.modal-brand{font-weight:700}.ingredient-list{display:flex;flex-wrap:wrap;gap:10rpx}.ingredient-list text{font-size:18rpx;background:#f5f5f4;border-radius:999rpx;padding:8rpx 12rpx}
