<view class="page zip-page profile-page"><view class="profile-hero"><view class="profile-avatar">L</view><view><view class="zip-title">我的肌肤记忆</view><view class="zip-sub">记录真实使用感受，让 AI 更懂你的肌肤</view></view><text class="gear" bindtap="privacy">⚙</text></view><view class="profile-card soft-card"><view><text class="strong">{{profile.name}}</text><text class="small">{{profile.skin}}</text></view><button class="zip-secondary" bindtap="cycle">生理周期设置</button></view><scroll-view scroll-x class="zip-tabs"><text wx:for="{{tabs}}" wx:key="*this" class="zip-tab {{active===item?'active':''}}" data-v="{{item}}" bindtap="select">{{item}}</text></scroll-view><view class="summary-grid"><view><text>舒服产品</text><text class="strong">12</text><text class="small">适合长期使用</text></view><view><text>需注意产品</text><text class="strong">5</text><text class="small">建议谨慎使用</text></view><view><text>避免产品</text><text class="strong">8</text><text class="small">已加入黑榜</text></view></view><view class="filter-card soft-card"><view><text class="strong">自动过滤黑榜产品</text><text class="small">加入黑榜的产品不会出现在未来护理计划中。</text></view><switch checked="{{filterBlack}}" bindchange="toggle" color="#4a7057"/></view><view class="section-line"><text>最近使用反馈</text><text class="link">全部反馈 &gt;</text></view><view wx:for="{{feedback}}" wx:key="id" class="feedback-card soft-card"><image src="{{item.image}}" mode="aspectFill"/><view><text class="strong">{{item.product}}</text><text class="status">{{item.feel}}</text><text class="small">护肤 · 最近使用</text><text>{{item.note}}</text></view></view><view class="profile-actions"><button class="zip-primary" bindtap="addFeedback">记录今日反馈</button><button class="zip-secondary" bindtap="exportData">导出全量数据</button><button class="zip-secondary danger-btn" bindtap="clear">清空本地数据</button></view><bottom-nav active-key="skin"/></view>