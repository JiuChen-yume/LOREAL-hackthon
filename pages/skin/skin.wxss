.tabs{white-space:nowrap;margin:28rpx 0}.tab{display:inline-block;padding:18rpx 24rpx;color:#8b7e7b}.tab.active{background:#4f8b72;color:#fff;border-radius:999rpx}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.summary{padding:22rpx 14rpx;border-radius:24rpx;display:flex;flex-direction:column;gap:10rpx}.summary .large{font-size:46rpx}.summary text{font-size:22rpx;color:#766f6d}.good{background:#ebf7ed;color:#21674d}.warn{background:#fff5df;color:#9a6615}.avoid{background:#fff0f1;color:#ae2736}.filter{margin-top:22rpx;display:grid;grid-template-columns:1fr auto;gap:10rpx}.filter text{grid-column:1/2;color:#7e7371;font-size:24rpx}.filter switch{grid-column:2;grid-row:1/3}.feedback{margin-bottom:16rpx}.feedback-head{display:flex;justify-content:space-between;font-size:29rpx}.status{background:#eaf6ec;color:#438463;border-radius:999rpx;padding:8rpx 16rpx;font-size:22rpx}

.feedback{display:grid;grid-template-columns:90rpx 1fr;column-gap:18rpx}.feedback-image{grid-row:1/4;width:90rpx;height:90rpx;border-radius:18rpx;background:#f8f3ef}.feedback-head{display:flex;justify-content:space-between}

.skin-header{height:190rpx;min-height:190rpx;background-size:38% auto;background-position:right top}
.profile-hero{display:flex;align-items:center;gap:16rpx;padding:24rpx 0}.profile-avatar{width:78rpx;height:78rpx;border-radius:50%;background:#4a7057;color:#fff;display:flex;align-items:center;justify-content:center;font:bold 34rpx serif}.gear{margin-left:auto;font-size:38rpx;color:#57534e}.profile-card{display:flex;align-items:center;justify-content:space-between;padding:20rpx;margin-bottom:20rpx}.profile-card strong,.profile-card small{display:block}.profile-card small{color:#78716c;font-size:18rpx;margin-top:8rpx}.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.summary-grid view{padding:18rpx 12rpx;border-radius:24rpx;display:flex;flex-direction:column;gap:7rpx}.summary-grid view:nth-child(1){background:#eff9ef}.summary-grid view:nth-child(2){background:#fff8e8}.summary-grid view:nth-child(3){background:#fff0f1}.summary-grid text,.summary-grid small{font-size:17rpx;color:#57534e}.summary-grid strong{font:bold 38rpx serif}.filter-card{padding:20rpx;margin-top:18rpx;display:flex;justify-content:space-between;align-items:center}.filter-card strong,.filter-card small{display:block}.filter-card small{font-size:17rpx;color:#78716c;margin-top:7rpx}.feedback-card{padding:14rpx;display:flex;gap:16rpx;margin-bottom:14rpx}.feedback-card image{width:90rpx;height:90rpx;border-radius:18rpx}.feedback-card view{display:flex;flex-direction:column;gap:5rpx;flex:1}.feedback-card strong{font-size:21rpx}.feedback-card small,.feedback-card text{font-size:17rpx;line-height:1.4;color:#78716c}.feedback-card .status{align-self:flex-end;color:#4a7057;background:#eff9ef;border-radius:999rpx;padding:5rpx 10rpx}.profile-actions{display:flex;gap:12rpx;margin-top:24rpx}.profile-actions button{flex:1}.danger-btn{color:#cf3f57;border-color:#cf3f57}
