.tabs{white-space:nowrap;margin:28rpx 0}.tab{display:inline-block;padding:18rpx 28rpx;color:#8b7e7b}.tab.active{background:#ed6470;color:#fff;border-radius:999rpx}.source{display:flex;align-items:center;justify-content:space-between}.source .strong{font-size:31rpx}.source .muted{margin-top:12rpx}.time{display:flex;justify-content:space-between;margin-top:20rpx;text-align:center}.time view{display:flex;flex-direction:column;gap:8rpx;padding:14rpx}.time .small{color:#9b8d89}.time .selected{border:2rpx solid #ed6470;border-radius:20rpx;color:#ed6470}.routine{margin-top:22rpx}.routine-head{display:flex;justify-content:space-between;font-size:32rpx;margin-bottom:18rpx}.routine-head text{color:#e49f4b;font-size:24rpx}.step{display:flex;align-items:center;padding:16rpx 0;border-top:1rpx solid #f0e2de}.num{width:52rpx;height:52rpx;line-height:52rpx;text-align:center;border-radius:50%;background:#ffca5a;color:#fff;font-weight:700;margin-right:20rpx}.step-main{display:flex;flex-direction:column;gap:5rpx}.step-main text,.step-main .small{color:#8c7e7b}.full{width:100%;margin-top:24rpx}

.source{background-size:cover;background-position:right center}.step-main image{width:90rpx;height:90rpx;float:right;margin-left:8rpx}

.care-header{height:150rpx;min-height:150rpx;background-size:100% auto;background-position:top}.source{padding:0;overflow:hidden}.source image{display:block;width:100%}
.care-tabs{margin:22rpx 0}.care-page .zip-title{margin-top:22rpx}.source-card{display:flex;align-items:center;gap:16rpx;padding:14rpx;margin-bottom:18rpx}.source-card image{width:150rpx;height:110rpx;border-radius:20rpx}.source-card view{flex:1}.source-card text,.source-card small{display:block}.source-card text{font-weight:700;font-size:22rpx}.source-card small{color:#78716c;font-size:17rpx;line-height:1.5;margin-top:6rpx}.time-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-bottom:20rpx}.time-item{background:#fff;border:1rpx solid #f0ebe6;border-radius:24rpx;padding:22rpx 8rpx;text-align:center;display:flex;flex-direction:column;gap:7rpx;color:#57534e;font-size:22rpx}.time-item strong{font-size:23rpx}.time-item small{font-size:17rpx;color:#a8a29e}.time-item.selected{border:2rpx solid #e25c70;color:#e25c70;background:#fff8f7}.routine-block{padding:20rpx;margin-bottom:18rpx}.routine-title{font:bold 27rpx serif;display:flex;justify-content:space-between;align-items:center;margin-bottom:14rpx}.routine-title small{font:20rpx sans-serif;color:#a8a29e}.care-step{display:grid;grid-template-columns:40rpx 80rpx 1fr;align-items:center;gap:12rpx;border-top:1rpx solid #f0ebe6;padding:14rpx 0}.care-step image{width:80rpx;height:80rpx;border-radius:18rpx}.care-step view{display:flex;flex-direction:column;gap:4rpx}.care-step strong{font-size:21rpx}.care-step text{font-size:18rpx;color:#57534e}.care-step small{font-size:17rpx;color:#a8a29e}.step-num{width:36rpx;height:36rpx;background:#f7bf4f;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700}.step-num.pink{background:#e25c70}.evening{background:#fff8ff}.wide{width:100%;box-sizing:border-box}.zip-secondary{width:100%;border:1rpx solid #e25c70;background:#fff;color:#e25c70;border-radius:999rpx;padding:18rpx;font-size:22rpx;margin-top:14rpx}
