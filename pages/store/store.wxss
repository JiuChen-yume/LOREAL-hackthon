.tabs{white-space:nowrap;margin:28rpx 0}.tab{display:inline-block;padding:18rpx 24rpx;color:#8b7e7b}.tab.active{background:#ed6470;color:#fff;border-radius:999rpx}.reminder{background:linear-gradient(110deg,#fff0f1,#fff9f5);margin-bottom:20rpx}.reminder .strong{display:block;font-size:32rpx;margin-bottom:14rpx}.reminder text{display:block;color:#7f7473;line-height:1.6}.reminder .strongutton{margin-top:20rpx}.recommend{display:flex;gap:18rpx;align-items:center;margin-bottom:18rpx;padding:20rpx}.recommend image{width:180rpx;height:180rpx;border-radius:18rpx}.recommend-main{flex:1;display:flex;flex-direction:column;gap:10rpx}.recommend-main .strong{font-size:29rpx}.recommend-main .large{color:#e55c65;font-size:32rpx}.ai-tag{font-size:21rpx;color:#a8752d}.recommend .ghost{font-size:21rpx;padding:12rpx 10rpx;white-space:nowrap}
.duplicate-card{display:flex;gap:18rpx;padding:16rpx;margin:20rpx 0}.duplicate-card image{width:220rpx;height:210rpx;border-radius:22rpx}.duplicate-card view{flex:1;display:flex;flex-direction:column;gap:8rpx}.duplicate-card strong{font-size:26rpx}.duplicate-card small{font-size:18rpx;color:#78716c;line-height:1.5}.ai-badge{display:block;color:#a8752d;font-size:18rpx}.mall-card{display:flex;gap:16rpx;padding:16rpx;margin-bottom:16rpx;align-items:center}.mall-card>image{width:180rpx;height:180rpx;border-radius:22rpx}.mall-main{flex:1;display:flex;flex-direction:column;gap:8rpx}.mall-main strong{font-size:24rpx}.mall-main small{font-size:17rpx;color:#78716c;line-height:1.4}.price{font:bold 30rpx serif;color:#e05252}.mall-card .zip-secondary{white-space:nowrap;padding:12rpx 14rpx;font-size:17rpx}
