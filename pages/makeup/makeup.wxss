.makeup-hero{height:300rpx;background-image:linear-gradient(90deg,rgba(255,240,235,.9),rgba(255,240,235,.25)),url('/assets/04_ai_makeup_studio/04_makeup-hero.png');background-size:cover;background-position:center}.hero-copy{font-size:34rpx;line-height:1.7;margin-top:120rpx}.features{display:flex;gap:14rpx;margin-top:22rpx}.feature{flex:1;min-height:220rpx;padding:22rpx 16rpx}.feature-title{font-size:30rpx;font-weight:700;margin-bottom:18rpx}.prefs{padding-bottom:18rpx}.looks{gap:14rpx}.looks .card{padding:14rpx}.looks image{width:100%;height:190rpx;border-radius:16rpx}.looks view{font-size:24rpx;margin:12rpx 0}.looks button{width:100%;font-size:23rpx;padding:14rpx 0}

.feature-image{width:100%;height:210rpx;border-radius:22rpx;display:block;margin-bottom:18rpx}.feature{overflow:hidden}

.makeup-hero{width:100%;height:300rpx;border-radius:32rpx;margin:22rpx 0;object-fit:cover}.makeup-features{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.makeup-feature{background:#fff;border:1rpx solid #f0ebe6;border-radius:26rpx;padding:12rpx;display:flex;flex-direction:column;gap:8rpx}.makeup-feature image{width:100%;height:220rpx;border-radius:20rpx}.makeup-feature strong{font-size:23rpx}.makeup-feature text{font-size:17rpx;color:#78716c;line-height:1.4}.style-panel{display:flex;align-items:center;gap:18rpx;padding:18rpx;margin-top:22rpx}.style-panel image{width:110rpx;height:110rpx;border-radius:50%}.style-panel strong{font:bold 27rpx serif}.pills{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:12rpx}.pills text{padding:8rpx 12rpx;background:#fff0ee;border-radius:999rpx;color:#962f43;font-size:17rpx}.look-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.look-card{padding:12rpx;display:flex;flex-direction:column;gap:10rpx}.look-card image{width:100%;height:220rpx;border-radius:20rpx}.look-card text{font-size:20rpx;font-weight:700}.look-card button{font-size:18rpx;padding:14rpx}
