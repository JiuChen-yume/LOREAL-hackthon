.cycle-head{color:#607d6c;margin:24rpx 0}.points{background:linear-gradient(110deg,#fff,#f0f7ee);margin-bottom:22rpx}.points .strong{display:block;font-size:34rpx}.points .large{font-size:58rpx;color:#eb6a67}.points text{display:block;margin-top:16rpx;color:#708073}.action-grid{gap:18rpx}.action{min-height:220rpx;display:flex;flex-direction:column;gap:14rpx}.action .strong{font-size:31rpx}.action text{color:#817573;line-height:1.5}.action .strongutton{margin-top:auto;align-self:flex-start}.community{background:linear-gradient(110deg,#fff1e8,#fff9f5)}.community .strong,.esg .strong{display:block;font-size:32rpx}.community text,.esg text{display:block;color:#7b706e;line-height:1.6;margin:14rpx 0}.esg{margin-top:20rpx;background:#eef7ef}

.action image{width:100%;height:150rpx;border-radius:20rpx;display:block;margin-bottom:16rpx}
.cycle-hero{display:flex;justify-content:space-between;align-items:center;padding:26rpx 0 18rpx}.cycle-hero image{width:180rpx;height:150rpx;border-radius:28rpx;object-fit:cover}.cycle-sub{font:32rpx serif;color:#4a7057;margin:10rpx 0}.cycle-hero text{font-size:18rpx;color:#78716c}.points-card{padding:24rpx;display:flex;justify-content:space-between;margin-bottom:20rpx}.points-card view{display:flex;flex-direction:column;gap:6rpx}.points-card strong{font:bold 48rpx serif;color:#e05252}.points-card small{font-size:18rpx;color:#78716c}.cycle-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx}.cycle-action{min-height:220rpx;border-radius:28rpx;padding:22rpx;display:flex;flex-direction:column;justify-content:space-between;color:#fff}.cycle-action strong{font:bold 27rpx serif}.cycle-action small{font-size:18rpx;line-height:1.5}.cycle-action button{align-self:flex-start;border:0;background:rgba(255,255,255,.22);color:#fff;border-radius:999rpx;padding:10rpx 14rpx;font-size:18rpx}.cycle-action.recycle{background:linear-gradient(135deg,#e25c70,#cf3f57)}.cycle-action.dropoff{background:linear-gradient(135deg,#4a7057,#395a44)}.cycle-action.points{background:linear-gradient(135deg,#e0a045,#c9852d)}.cycle-action.community{background:linear-gradient(135deg,#8c5e7a,#6e425d)}.community-card{padding:16rpx;display:grid;grid-template-columns:130rpx 1fr;gap:12rpx;align-items:center}.community-card image{width:130rpx;height:120rpx;border-radius:20rpx;grid-row:span 3}.community-card strong{font-size:24rpx}.community-card text{font-size:18rpx;color:#78716c;line-height:1.4}.record-card{padding:20rpx;margin-top:20rpx}.record-card>strong{font:bold 26rpx serif;display:block;margin-bottom:14rpx}.record-card view{display:flex;justify-content:space-between;border-top:1rpx solid #f0ebe6;padding:14rpx 0;font-size:18rpx}.success{color:#4a7057}
