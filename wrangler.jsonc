{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "beauty-twin-ai",
	"main": "cloudflare/worker.ts",
	// Keep this aligned with the locally installed Wrangler runtime. Update it
	// to the current date when Wrangler is upgraded before production deploy.
	"compatibility_date": "2026-08-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "beauty-twin-db",
			"database_id": "a96a7b47-b8d2-4390-84fe-34fe00554efe",
			"migrations_dir": "./migrations"
		}
	],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "beauty-twin-images"
    }
  ],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"APP_ENV": "production"
	},
	"observability": {
		"enabled": true
	}
}
